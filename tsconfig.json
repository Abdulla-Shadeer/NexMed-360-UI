{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./src/",
    "paths": {
      "@/app*": ["app/*"],
      "@/components/*":["_components/*"],
      "@/hooks":["_hooks/index.ts"],
      "@/context":["_context/index.ts*"],
      "@/utils":["_utils/index.ts"],
      "@/public/*":["../public/*"],
      "@/appIcons/*":["../public/app_icons/*"],
      "@/types":["_types/index.ts"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
